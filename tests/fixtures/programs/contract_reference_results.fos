pub type Value = {
    pub value: Int
    pub func read() -> Int [read self]
}
impl Value {
    pub func read() -> Int {
        self.value
    }
}
type Item = & Value & {
    pub extra: String
}
type Other = & Value & {
    pub marker: Int, pub tail: String
}
pub func borrowed(item: Value) -> ref[item] Value {
    ref item
}
pub func forwarded(item: Value) -> ref[item] Value {
    borrowed(item)
}
pub func ordinary(item: Value) -> ref[item] Value {
    ref item
}
pub func existing(item: Value) -> ref[item] Value {
    let saved = ref item
    ref saved
}
func increase(item: Value) -> () {
    item.value = item.value + 1
}
func increase_generic<T & Value>(item: T) -> () {
    item.value = item.value + 1
}
pub type NumberBorrow = {
    pub func borrow() -> ref[self] Int
}
pub enum Number = Stored(Int) & NumberBorrow
impl Number {
    pub func borrow() -> ref[self] Int {
        branch self {
            Number.Stored(value) -> ref value
        }
    }
}
func number(value: NumberBorrow) -> ref[value] Int {
    value.borrow()
}
func read_number(value: Int) -> Int {
    value
}
func early(item: Value) -> ref[item] Value {
    return forwarded(item) if item.value < 30
    ref item
}
type Holder = {
    item: Item
}
func child(holder: Holder) -> ref[holder] Value {
    ref holder.item
}
func main() -> Int {
    let first = Item {
        extra: "first", value: 20
    }
    let second = Other {
        marker: 9, tail: "second", value: 20
    }
    let first_borrow = early(existing(first))
    increase(first_borrow)
    assert(first_borrow.read() == 21)
    let second_borrow = ordinary(second)
    increase_generic(second_borrow)
    assert(second_borrow.read() == 21)
    let holder = Holder {
        item: Item {
            extra: "nested", value: 41
        }
    }
    let nested = child(holder)
    nested.value = nested.value + 1
    assert(holder.item.value == 42 && holder.item.extra == "nested")
    assert(first.extra == "first" && second.marker == 9 && second.tail == "second")
    let stored = Number.Stored(42)
    assert(read_number(number(stored)) == 42)
    first.value + second.value
}
