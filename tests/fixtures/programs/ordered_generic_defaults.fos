pub type Provider<T> = {}
impl<T> Provider<T> {
    pub func echo(value: T) -> T [consume value] {
        value
    }
}

impl<T> Provider<T> {
    pub func score(value: Int) -> Int {
        value + 1
    }
}

impl<T> Provider<T> {
    pub func score(value: String) -> Int {
        9
    }
}

impl<T> Provider<T> {
    pub func closure() -> func(Int) -> Int {
        (value: Int) -> value + 1
    }
}
pub type Middle<U> = & Provider<U> & {}
pub type Other = {}
impl Other {
    pub func score(value: Int) -> Int {
        value + 2
    }
}
type Concrete = & Middle<Int> & Other & {}
func main() -> Int {
    let value = Concrete {}
    assert(value.score(10) == 12)
    assert(value.score("text") == 9)
    assert(value.closure()(10) == 11)
    value.echo(42)
}
