pub type Item = {
    pub value: Int
}

impl Item {
    pub static func new() -> Self {
        Item {
            value: 42
        }
    }
}

pub type Box<T> = {
    pub value: T
}

impl Box<T> {
    pub static func new(value: T) -> Self [consume value] {
        Box {
            value
        }
    }
}
